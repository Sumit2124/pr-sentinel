# =====================================================================
# PR-Sentinel Configuration
# =====================================================================

# LLM Provider Configuration
# Choose: "gemini/gemini-1.5-pro", "gemini/gemini-1.5-flash", "gpt-4o", "claude-3-5-sonnet-20240620", "ollama/qwen2.5-coder:7b"
LLM_MODEL=gemini/gemini-1.5-flash
LLM_TEMPERATURE=0.2

# API Keys (Set whichever provider you are using)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama local endpoint (if using local models)
OLLAMA_API_BASE=http://localhost:11434

# GitHub API Integration (Optional for local diffs, required for PR Bot mode)
GITHUB_TOKEN=

# Review Settings
SEVERITY_THRESHOLD=LOW  # LOW, MEDIUM, HIGH, CRITICAL
ENABLE_AUTO_FIX=true
AUTO_GENERATE_TESTS=true
MAX_DIFF_LINES=2000
